{
  "name": "screen-spec-md",
  "version": "0.1.0",
  "description": "Generate compact Markdown screen specifications from Figma frames.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joeldfs/screen-spec-md.git"
  },
  "bugs": {
    "url": "https://github.com/joeldfs/screen-spec-md/issues"
  },
  "homepage": "https://github.com/joeldfs/screen-spec-md#readme",
  "engines": {
    "node": ">=22 <26",
    "npm": ">=10"
  },
  "dependencies": {
    "@create-figma-plugin/ui": "^4.0.3",
    "@create-figma-plugin/utilities": "^4.0.3",
    "preact": ">=10"
  },
  "devDependencies": {
    "@create-figma-plugin/build": "^4.0.3",
    "@create-figma-plugin/tsconfig": "^4.0.3",
    "@figma/plugin-typings": "1.109.0",
    "typescript": ">=5"
  },
  "scripts": {
    "build": "build-figma-plugin --typecheck --minify",
    "watch": "build-figma-plugin --typecheck --watch"
  },
  "figma-plugin": {
    "editorType": [
      "figma",
      "dev"
    ],
    "id": "1642215897646749039",
    "documentAccess": "dynamic-page",
    "capabilities": [
      "inspect",
      "codegen"
    ],
    "codegenLanguages": [
      {
        "label": "Markdown",
        "value": "markdown"
      }
    ],
    "name": "Screen Spec MD",
    "main": "src/main.ts",
    "ui": "src/ui.tsx",
    "networkAccess": {
      "allowedDomains": [
        "none"
      ]
    }
  }
}
